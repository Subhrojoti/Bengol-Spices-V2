# Connection details for the Hostinger VPS.
# Copy to deploy/deploy.env and fill in. This file is gitignored.

VPS_HOST=            # VPS IP address, e.g. 72.60.12.34
VPS_USER=root        # SSH user Hostinger gave you
VPS_PORT=22          # SSH port, 22 unless you changed it

WEB_ROOT=/var/www/Bengol-Spices-V2/FrontEnd/dist
API_ROOT=/var/www/Bengol-Spices-V2/BackEnd
