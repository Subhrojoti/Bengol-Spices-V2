# Copy this file to .env and fill in your backend's URL.
#
# IMPORTANT: if you're testing on a physical phone with Expo Go, "localhost"
# refers to the PHONE itself, not your computer — it will NOT work.
# Use your computer's LAN IP address instead (run ipconfig / ifconfig).
#
# This address is only used while developing. An installed build (an APK)
# talks to https://api.bengolspices.com unless this is an https address:
# see src/api/baseUrl.ts. EAS builds set it themselves, in eas.json.
#
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
