{
  "expo": {
    "name": "Bengol Agent",
    "slug": "bengol-spices-agent-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bengolagent",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bengolspices.agent"
    },
    "android": {
      "package": "com.bengolspices.agent",
      "adaptiveIcon": {
        "backgroundColor": "#1a0201",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#1a0201"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Bengol Spices Agent to access your photos to upload store and document images.",
          "cameraPermission": "Allow Bengol Spices Agent to use the camera to take store and document photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Bengol Spices Agent to use your location to record store locations accurately."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c9711eb4-0281-40e7-83e1-3fac367636a7"
      }
    }
  }
}
