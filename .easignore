# EAS archives from the Git repository root, even when run inside an app.
# Both apps are self-contained; retain their sources, assets, lockfiles and
# build scripts (including Agent patch-package patches).
/*
!/agent-app
!/delivery-app

# .easignore replaces all nested .gitignore rules. Repeat build exclusions.
node_modules
.expo
dist
web-build
.kotlin
.gradle
build
coverage
.metro-health-check*
expo-env.d.ts
*.tsbuildinfo
*.orig.*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store

# Native projects are generated by Expo Prebuild, as in each app's .gitignore.
/agent-app/android
/agent-app/ios
/delivery-app/android
/delivery-app/ios

# Use EAS-managed signing and the API URL in eas.json, never local credentials.
.env
.env.*
!.env.example
credentials.json
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision
